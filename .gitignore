# Dependencies
node_modules/
**/node_modules/
backend/vendor/
frontend/node_modules/
Logos/node_modules/

# Env / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*

# Build / runtime
# frontend/dist is tracked so shared-hosting updates from GitHub include the UI
backend/public/build/
backend/public/hot
backend/storage/*.key
backend/storage/app/feed/
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
*.log

# Composer local phar (use system composer or CI cache)
backend/composer.phar
composer.phar

# IDE / OS / editor
.idea/
.vscode/
.cursor/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Composer installer leftovers
composer-setup.php
composer-setup.php.*

# Local Docker volumes / dumps
*.sql.gz
*.dump

# Connector build artifacts stay tracked under connector/dist for probe installs
# (ZIP contains no secrets)
